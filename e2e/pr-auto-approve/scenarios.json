    "clean-no-open-issues": {
      "BASE_BRANCH": "main",
      "ROUNDS_BY_TYPE": "default:3",
      "COPILOT_CLEAN_ON": "no-open-issues"
    },
    "routes": {
      "BASE_BRANCH": "develop,main",
      "ROUNDS_BY_TYPE": "chore:0,default:3",
      "PROMOTION_BRANCHES": "develop:main",
      "RELEASE_BRANCHES": "develop:main",
      "RELEASE_AUTHOR": "{reviewer}"
    },
    "routes-other-author": {
      "BASE_BRANCH": "develop,main",
      "ROUNDS_BY_TYPE": "chore:0,default:3",
      "PROMOTION_BRANCHES": "develop:main",
      "RELEASE_BRANCHES": "develop:main",
      "RELEASE_AUTHOR": "someone-else[bot]"
    }
  },
  "exemptions": {
    "copilot-error-retries": "Real Copilot cannot be made to error on demand, so the real tier cannot drive it. A synthetic scenario that posts the errored wording and asserts the re-request is tracked separately.",
    "allow-no-checks": "The sandbox always has CI; unit tests cover the no-checks branch.",
    "slack-channel": "The sandbox has no Slack workspace to assert against.",
    "slack-bot-token": "The sandbox has no Slack workspace to assert against."
  },
